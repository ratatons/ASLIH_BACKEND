# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aslih

# JWT
JWT_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# Geo
ARRIVAL_RADIUS_METERS=50

# Optional: bootstraps a SUPER_ADMIN account on first boot if no account with
# this email exists yet. Leave unset to skip (create admins via seed script
# or by promoting a self-registered account's role instead).
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_PHONE=

# File storage
# "local" stores files on disk under /uploads (served statically) - fine for Render disk-backed deploys / demos
# "s3" uses an S3-compatible bucket (recommended for production - Render has ephemeral disk)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# S3-compatible object storage (only needed when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
